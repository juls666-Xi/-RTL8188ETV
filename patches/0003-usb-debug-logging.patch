diff --git a/os_dep/usb_intf.c b/os_dep/usb_intf.c
index 1234567..abcdefg 100644
--- a/os_dep/usb_intf.c
+++ b/os_dep/usb_intf.c
@@ -1,5 +1,14 @@
 #define _USB_INTF_C_

+/*
+ * RTL8188EUS USB Interface Debugging Enhancement
+ * Adds comprehensive logging to USB probe/disconnect paths
+ * for troubleshooting device detection issues on Fedora
+ */
+
+#define USB_DBG(fmt, ...) \
+	pr_info("[RTL8188EUS-USB] %s: " fmt "\n", __func__, ##__VA_ARGS__)
+
 #include <drv_types.h>
 #include <hal_data.h>

@@ -15,6 +24,8 @@ struct rtw_usb_drv {
 static int rtw_usb_probe(struct usb_interface *pusb_intf, const struct usb_device_id *pdid)
 {
 	struct dvobj_priv *pdvobjpriv;
+	
+	USB_DBG("USB probe started for device %04x:%04x", pdid->idVendor, pdid->idProduct);

 	if((pdvobjpriv = devobj_init()) == NULL) {
 		goto exit;
@@ -22,6 +33,8 @@ static int rtw_usb_probe(struct usb_interface *pusb_intf, const struct usb_devi

 	pdvobjpriv->pusbintf = pusb_intf;
 	pdvobjpriv->pusbdev = interface_to_usbdev(pusb_intf);
+	
+	USB_DBG("USB device initialized, preparing adapter");

 	if (rtw_init_drv_sw(pdvobjpriv) !=_SUCCESS)
 		goto free_dvobj;
@@ -30,6 +43,8 @@ static int rtw_usb_probe(struct usb_interface *pusb_intf, const struct usb_devi
 		goto free_drv_sw;
 	}

+	USB_DBG("USB probe completed successfully");
+	
 	return 0;

 free_drv_sw:
@@ -43,6 +58,8 @@ exit:
 static void rtw_usb_disconnect(struct usb_interface *pusb_intf)
 {
 	struct dvobj_priv *pdvobjpriv = usb_get_intfdata(pusb_intf);
+	
+	USB_DBG("USB disconnect called");

 	if(pdvobjpriv) {
 		rtw_deinit_drv_sw(pdvobjpriv);
@@ -50,6 +67,8 @@ static void rtw_usb_disconnect(struct usb_interface *pusb_intf)
 		devobj_deinit(pdvobjpriv);
 		usb_set_intfdata(pusb_intf, NULL);
 	}
+	
+	USB_DBG("USB disconnect completed");
 }

 static int __init rtw_drv_entry(void)
@@ -57,6 +76,8 @@ static int __init rtw_drv_entry(void)
 	RT_TRACE(_module_hci_intfs_c_, _drv_err_, ("+rtw_drv_entry\n"));
 	RT_TRACE(_module_hci_intfs_c_, _drv_err_, ("\n ======= version %s =======\n", DRIVERVERSION));

+	pr_info("[RTL8188EUS] Driver loading, version %s\n", DRIVERVERSION);
+	
 	usb_drv.drv_registered = _TRUE;

 	#if (LINUX_VERSION_CODE < KERNEL_VERSION(2,6,24))
@@ -66,6 +87,8 @@ static int __init rtw_drv_entry(void)
 	#endif

 	usb_register(&usb_drv.usbdrv);
+	
+	pr_info("[RTL8188EUS] USB driver registered\n");

 	return 0;
 }
@@ -73,6 +96,8 @@ static int __init rtw_drv_entry(void)
 static void __exit rtw_drv_halt(void)
 {
 	RT_TRACE(_module_hci_intfs_c_, _drv_err_, ("+rtw_drv_halt\n"));
+	
+	pr_info("[RTL8188EUS] Driver unloading\n");

 	usb_drv.drv_registered = _FALSE;

@@ -80,6 +105,8 @@ static void __exit rtw_drv_halt(void)
 		usb_deregister(&usb_drv.usbdrv);

 		RT_TRACE(_module_hci_intfs_c_, _drv_err_, ("-rtw_drv_halt\n"));
+		
+		pr_info("[RTL8188EUS] USB driver deregistered\n");
 	}
 }
